# DuesPilot environment configuration

# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# PostgreSQL connection string.
# Local Prisma dev (via `npx prisma dev -d`):
# DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DB?sslmode=require"

# NextAuth v5 secret - generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"

# Public base URL (http://localhost:3000 in development)
AUTH_URL="http://localhost:3000"

# Optional: bearer token protecting /api/jobs/promise-sweep (cron trigger).
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-strong-random-secret"