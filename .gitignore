# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output & caches
/.next/
/out/
/build
/dist
/.swc/

# Testing & E2E (Vitest & Playwright)
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.vitest/
/.vitest-cache/

# Prisma & Database
/src/generated/prisma/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal

# Environment variables
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# TypeScript & Next.js type declarations
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Security & Certificates
*.pem
*.key
*.cert

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor files
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# AI agent & developer tooling artifacts
.agents/
.claude/
.windsurf/
.cursor/
.gemini/
skills-lock.json

